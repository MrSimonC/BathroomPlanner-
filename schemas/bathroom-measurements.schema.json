{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "confirmed"
      ]
    },
    "supersedesRevision": {
      "type": "integer",
      "minimum": 1
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time"
    },
    "confirmedBy": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "const": "mm"
    },
    "coordinateSystem": {
      "const": "plan-x-right-y-down-z-up"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 0
    },
    "geometry": {
      "$ref": "#/$defs/geometry"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "status",
    "units",
    "coordinateSystem",
    "sources",
    "geometry"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bathroomplanner:schema:bathroom-measurements:1.0.0",
  "title": "Bathroom measurement snapshot",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verified": {
          "type": "boolean"
        },
        "method": {
          "enum": [
            "measured",
            "manufacturer",
            "derived",
            "estimated",
            "user-reported"
          ]
        },
        "note": {
          "type": "string"
        },
        "verifiedBy": {
          "type": "string",
          "minLength": 1
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [],
      "allOf": [
        {
          "if": {
            "properties": {
              "verified": {
                "const": true
              }
            },
            "required": [
              "verified"
            ]
          },
          "then": {
            "required": [
              "verifiedBy",
              "verifiedAt"
            ]
          }
        }
      ],
      "description": "Optional evidence fields. Omitted source, confidence or verification is unknown; never invent a confidence score or interpret absence as verified."
    },
    "length": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "const": "mm"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "description": "Canonical millimetres, including fractional mm. Never round a confirmed value for display convenience."
    },
    "positiveLength": {
      "allOf": [
        {
          "$ref": "#/$defs/length"
        },
        {
          "properties": {
            "value": {
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "nonnegativeLength": {
      "allOf": [
        {
          "$ref": "#/$defs/length"
        },
        {
          "properties": {
            "value": {
              "minimum": 0
            }
          }
        }
      ]
    },
    "angle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "const": "deg"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "description": "Clockwise in plan view; zero aligns width with +x."
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/length"
        },
        "y": {
          "$ref": "#/$defs/length"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "polygon": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      },
      "minItems": 3,
      "description": "Ordered vertices; last-to-first closure is implicit. No duplicate terminal point. Recesses are actual concave boundary vertices."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "survey",
            "drawing",
            "photo",
            "scan",
            "manufacturer",
            "user",
            "calculation"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "reference"
      ],
      "description": "Reference resolves in the private data repository. Do not embed private assets in a public fixture."
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        },
        "thickness": {
          "$ref": "#/$defs/positiveLength"
        },
        "height": {
          "$ref": "#/$defs/positiveLength"
        },
        "mobility": {
          "const": "fixed"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "thickness",
        "height",
        "mobility"
      ],
      "description": "Directed wall centreline. Interior boundary remains a separate measured polygon."
    },
    "door": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "wallId": {
          "$ref": "#/$defs/id"
        },
        "offsetFromStart": {
          "$ref": "#/$defs/nonnegativeLength"
        },
        "width": {
          "$ref": "#/$defs/positiveLength"
        },
        "height": {
          "$ref": "#/$defs/positiveLength"
        },
        "type": {
          "enum": [
            "single",
            "double",
            "sliding",
            "french",
            "pocket",
            "bifold",
            "opening",
            "garage"
          ]
        },
        "hingeJamb": {
          "enum": [
            "start",
            "end",
            "none"
          ]
        },
        "swingSide": {
          "enum": [
            "positive-normal",
            "negative-normal",
            "none"
          ]
        },
        "openingAngle": {
          "$ref": "#/$defs/angle"
        },
        "mobility": {
          "enum": [
            "fixed",
            "movable"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "id",
        "wallId",
        "offsetFromStart",
        "width",
        "height",
        "type",
        "hingeJamb",
        "swingSide",
        "mobility"
      ],
      "description": "Offset locates opening centre along directed wall centreline. Positive normal = (-dy, dx); explicit none for leafless/non-swing types."
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "wallId": {
          "$ref": "#/$defs/id"
        },
        "offsetFromStart": {
          "$ref": "#/$defs/nonnegativeLength"
        },
        "width": {
          "$ref": "#/$defs/positiveLength"
        },
        "height": {
          "$ref": "#/$defs/positiveLength"
        },
        "sillHeight": {
          "$ref": "#/$defs/nonnegativeLength"
        },
        "type": {
          "enum": [
            "standard",
            "fixed",
            "casement",
            "sliding",
            "bay"
          ]
        },
        "mobility": {
          "enum": [
            "fixed",
            "movable"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "id",
        "wallId",
        "offsetFromStart",
        "width",
        "height",
        "sillHeight",
        "type",
        "mobility"
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "rotation": {
          "$ref": "#/$defs/angle"
        },
        "width": {
          "$ref": "#/$defs/positiveLength"
        },
        "depth": {
          "$ref": "#/$defs/positiveLength"
        },
        "height": {
          "$ref": "#/$defs/positiveLength"
        },
        "baseHeight": {
          "$ref": "#/$defs/nonnegativeLength"
        },
        "footprint": {
          "$ref": "#/$defs/polygon"
        },
        "mobility": {
          "enum": [
            "fixed",
            "movable"
          ]
        },
        "serviceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "id",
        "kind",
        "position",
        "rotation",
        "width",
        "depth",
        "height",
        "mobility",
        "serviceIds"
      ],
      "description": "Position is footprint centre. Optional footprint contains local coordinates before rotation. Fixed fixtures cannot be moved by layout proposals."
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "hot-water",
            "cold-water",
            "waste",
            "soil-stack",
            "electrical",
            "ventilation",
            "heating",
            "other"
          ]
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "heightAboveFloor": {
          "$ref": "#/$defs/nonnegativeLength"
        },
        "diameter": {
          "$ref": "#/$defs/positiveLength"
        },
        "mobility": {
          "enum": [
            "fixed",
            "movable"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "id",
        "kind",
        "position",
        "heightAboveFloor",
        "mobility"
      ]
    },
    "clearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "access",
            "door-swing",
            "maintenance",
            "fixture-use",
            "keep-clear",
            "other"
          ]
        },
        "polygon": {
          "$ref": "#/$defs/polygon"
        },
        "relatedElementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "minimumWidth": {
          "$ref": "#/$defs/positiveLength"
        },
        "severity": {
          "enum": [
            "hard",
            "preference"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "id",
        "kind",
        "polygon",
        "relatedElementIds",
        "severity"
      ],
      "description": "Absolute plan coordinates. Provenance identifies user/manufacturer guidance; this is not automatic building-regulation certification."
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interiorPerimeter": {
          "$ref": "#/$defs/polygon"
        },
        "obstructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/polygon"
          },
          "minItems": 0
        },
        "ceilingHeight": {
          "$ref": "#/$defs/positiveLength"
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wall"
          },
          "minItems": 3
        },
        "doors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/door"
          },
          "minItems": 0
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/window"
          },
          "minItems": 0
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixture"
          },
          "minItems": 0
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          },
          "minItems": 0
        },
        "clearances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clearance"
          },
          "minItems": 0
        }
      },
      "required": [
        "interiorPerimeter",
        "obstructions",
        "ceilingHeight",
        "walls",
        "doors",
        "windows",
        "fixtures",
        "services",
        "clearances"
      ],
      "description": "Existing measured state. Interior perimeter includes every recess/alcove; obstructions are closed interior holes. Layout alternatives are separate documents."
    }
  },
  "description": "Canonical complete survey contract, separate from OpenPlan3D import JSON. Measurement evidence metadata is optional; omitted evidence is unknown. Partial capture notes and empty setup placeholders are not complete schema-valid snapshots. Cross-reference, geometry and immutable-revision checks require a future application validator. No actual room data is included.",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        }
      },
      "then": {
        "required": [
          "confirmedAt",
          "confirmedBy"
        ]
      }
    }
  ]
}
